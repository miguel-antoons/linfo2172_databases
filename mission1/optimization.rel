1.
(summarize (Independence join Encompasses) per (Encompasses {continent}): {countries := count()})
join
(summarize (
    ((((CountryCovid {country, year, total_cases} where year = 2021) {country, total_cases}) minus (((((CountryCovid {country, year, total_cases} where year = 2021) rename {total_cases as tot}) join (CountryCovid {country, year, total_cases} where year = 2021) ) where tot < total_cases) {country, tot} rename {tot as total_cases})) join Encompasses) {continent, total_cases}) per (Encompasses {continent}
): {covid_cases := sum(total_cases)})

2.
((((((GeoMountain {mountain, country} rename {country as country1})
join
GeoMountain) {mountain, country1, country} where country1 < country)
join
(Country {code, name} rename {code as country1})) {mountain, country, name} rename {name as country1})
join
(Country {code, name} rename {code as country})) {mountain, country1, name} rename {name as country2}

3.
((((extend (((((Encompasses {country, continent} where continent = "Asia") join ((Country where population > 200000000) {code}) where code = country) {country})
join
((CountryCovid where year = 2020 and month = 12) {country, total_cases} rename {total_cases as total_cases_20}))
join
((CountryCovid where year = 2021 and month = 12) {country, total_cases} rename {total_cases as total_cases_21}))
join
((CountryCovid where year = 2022 and month = 12) {country, total_cases} rename {total_cases as total_cases_22}): {inc_21 := total_cases_21 - total_cases_20, inc_22 := total_cases_22 - total_cases_21}) where inc_21 > inc_22) {country} rename {country as code})
join Country) {name} rename {name as country}

4.
((((Province where area > 5000.0) {country} join Borders where country = country2) {country1} join Language) rename {name as language}) {country, language}

5.
((summarize (Borders) by {country1}: {cnt := count()}) where cnt = 3) {country1} rename {country1 as country}

extend (Borders {country1, country2} where country1 > country2): {cnt := count(country1)}

(((Borders {country1, country2}) where country1 > country2) {country1, country2}) join (((Borders {country1, country2}) where country1 > country2) {country1, country2} rename {country2 as country3}) join (((Borders {country1, country2}) where country1 > country2) {country1, country2} rename {country2 as country4})

6.
with(
    t1 := (extend (((CountryCovid where month = 12) where year = 2022) {country, total_cases}) join (Country {code, population} rename {code as country}): {ratio := CAST_AS_RATIONAL(total_cases) / CAST_AS_RATIONAL(population)}) {country, ratio}
):
(((t1 rename {country as country1}) join (Borders {country1, country2})) {country1} rename {country1 as country})
minus
((((((t1 rename {country as country1}) join (Borders {country1, country2})) rename {ratio as ratio1})
join
(((t1 rename {country as country1}) join (Borders {country1, country2})) rename {country1 as c2, country2 as c1} rename {c1 as country1, c2 as country2}))
where ratio < ratio1) {country2} rename {country2 as country})

# new version
with(
    t1 := ((extend (((CountryCovid where month = 12) where year = 2022) {country, total_cases}) join (Country {code, population} rename {code as country}): {ratio := CAST_AS_RATIONAL(total_cases) / CAST_AS_RATIONAL(population)}) {country, ratio} rename {country as country1}) join (Borders {country1, country2})
):
(((CountryCovid where month = 12) where year = 2022) {country}) join ((Borders {country1}) rename {country1 as country})
minus
((((t1 rename {ratio as ratio1})
join
((t1 rename {country1 as c2, country2 as c1}) rename {c1 as country1, c2 as country2}))
where ratio < ratio1) {country2} rename {country2 as country})


